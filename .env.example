# Copy this file to .env and fill in your keys.
# .env is gitignored so your keys stay local.

# Financial Modeling Prep  -> fundamentals, ratios, sector P/E, earnings calendar, transcripts
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Polygon.io  -> bulk daily bars (grouped) for breadth + index/price technicals
# https://polygon.io/docs
POLYGON_API_KEY=

# EODHD (optional alternative to Polygon for bulk EOD)
# https://eodhd.com/financial-apis
EODHD_API_KEY=

# Alpha Vantage -> FREE earnings-call transcripts (concalls), 25 requests/day.
# Get a free key (email only, instant, no card): https://www.alphavantage.co/support/#api-key
# Leave blank to use the shared "demo" key, which only works for IBM.
ALPHAVANTAGE_API_KEY=

# Which price provider to use for bulk daily bars: polygon | eodhd
PRICE_PROVIDER=polygon
